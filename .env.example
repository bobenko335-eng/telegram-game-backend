# Скопируйте в .env локально. На Railway задайте это через Variables,
# сам .env в репозиторий не коммитить (см. .gitignore).

TELEGRAM_BOT_TOKEN=your_bot_token_here

# Через запятую можно перечислить домены, откуда игре разрешено
# ходить к backend. По умолчанию "*" (разрешить всем) — для продакшена
# лучше сузить до реального домена, где хостится игра.
ALLOWED_ORIGINS=*
